	heading.resize(count)
	for i in count:
		var d: Vector3 = _pos[(i + 1) % count] - _pos[(i - 1 + count) % count]
		d.y = 0.0
		_tan[i] = d.normalized()
		heading[i] = atan2(_tan[i].z, _tan[i].x)
	var raw := PackedFloat32Array()
	raw.resize(count)
	for i in count:
		raw[i] = wrapf(heading[(i + 1) % count] - heading[i], -PI, PI) / step
	_curv.resize(count)
	for i in count:                       # light smoothing so the speed profile is not noisy
		var sum := 0.0
		for j in range(-2, 3):
			sum += raw[(i + j + count) % count]
		_curv[i] = sum / 5.0
	_slope.resize(count)
	for i in count:
		_slope[i] = (_pos[(i + 1) % count].y - _pos[(i - 1 + count) % count].y) / (2.0 * step)


func wrap_s(s: float) -> float:
	return fposmod(s, length)


func _index(s: float) -> Array:
	var f := wrap_s(s) / step
	var i := int(f) % count
	return [i, f - floorf(f)]


## Point on the centre line, including the road height.
func center(s: float) -> Vector3:
	var ix := _index(s)
	var i: int = ix[0]
	return _pos[i].lerp(_pos[(i + 1) % count], float(ix[1]))


## Direction of travel, always horizontal.
func tangent(s: float) -> Vector3:
	var ix := _index(s)
	var i: int = ix[0]
	return _tan[i].lerp(_tan[(i + 1) % count], float(ix[1])).normalized()


func side(s: float) -> Vector3:
	var t := tangent(s)
	return Vector3(-t.z, 0.0, t.x)


func curvature(s: float) -> float:
	var ix := _index(s)
	var i: int = ix[0]
	return lerpf(_curv[i], _curv[(i + 1) % count], float(ix[1]))


## Rise of the road per metre driven (0.05 = 5 % uphill).
func slope(s: float) -> float:
	var ix := _index(s)
	var i: int = ix[0]
	return lerpf(_slope[i], _slope[(i + 1) % count], float(ix[1]))


func in_tunnel(s: float) -> bool:
	var w := wrap_s(s)
	return w >= TUNNEL_START and w <= TUNNEL_END


func in_bridge(s: float) -> bool:
	var w := wrap_s(s)
	return w >= BRIDGE_START and w <= BRIDGE_END


## Fastest speed (m/s) allowed at distance s when a car can corner with lateral acceleration a_lat and brakes with
## `brake` m/s^2 for the corners ahead. Cached per (a_lat, brake).
func speed_limit(a_lat: float, brake: float, v_top: float, s: float) -> float:
	var key := "%.2f:%.1f:%.1f" % [a_lat, brake, v_top]
	if not _profiles.has(key):
		_profiles[key] = _build_profile(a_lat, brake, v_top)
	var profile: PackedFloat32Array = _profiles[key]
	return profile[int(wrap_s(s) / step) % count]


func _build_profile(a_lat: float, brake: float, v_top: float) -> PackedFloat32Array:
	var v := PackedFloat32Array()
	v.resize(count)
	for i in count:
		v[i] = minf(v_top, sqrt(a_lat / maxf(absf(_curv[i]), 0.0001)))
	for _sweep in 3:                      # propagate the braking zones backwards around the loop
		for n in range(count * 2):
			var j := (count - 1 - n % count + count) % count
			var nxt := (j + 1) % count
			v[j] = minf(v[j], sqrt(v[nxt] * v[nxt] + 2.0 * brake * 0.8 * step))
	return v
